# Copy to .env and fill in. Never commit .env.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Where results, jobs and caches are saved
NCE_DATA_DIR=./data
# Website origin(s) allowed to call the API, comma-separated (* for any during the hackathon)
NCE_CORS_ORIGINS=*
# Public URL of this API, used in image links (leave empty for relative links)
NCE_PUBLIC_BASE_URL=
NCE_TARGET_RES_M=20
NCE_MAX_AREA_KM2=900
NCE_WORKERS=2
FIRMS_MAP_KEY=
# Optional: Canada's EODMS account for RADARSAT Constellation / RADARSAT-1 availability checks
EODMS_USERNAME=
EODMS_PASSWORD=
